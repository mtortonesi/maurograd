#!/usr/bin/env ruby

require 'securerandom'
require 'chunky_png'
require 'erv'

# Function to generate two interleaving half circles (moons)
# Parameters
# - n_samples: Total number of samples to generate (default: 100)
# - noise: Standard deviation of Gaussian noise added to the data (default: 0.1)
# - seed: Random seed for reproducibility (default: nil)
def generate_moons(n_samples: 100, noise: 0.1, seed: nil)
  unif_rng = seed ? ERV::UniformDistribution.new(max_value: 1.0, seed: seed) : ERV::UniformDistribution.new(max_value: 1.0)
  gaussian_rng = seed ? ERV::GaussianDistribution.new(mean: 0.0, sd: noise, seed: seed) : ERV::GaussianDistribution.new(mean: 0.0, sd: noise)

  n_samples_out = n_samples / 2
  n_samples_in = n_samples - n_samples_out

  # Generate outer circle
  theta_out = Array.new(n_samples_out) { Math::PI * unif_rng.sample }
  x_out = theta_out.map do |el|
    [ Math::cos(el), Math::sin(el) ]
  end
  # theta_out = Numo::DFloat.linspace(0, Math::PI, n_samples_out)
  # x_out = Numo::DFloat[theta_out.cos, theta_out.sin].transpose

  # Generate inner circle
  theta_in = Array.new(n_samples_in) { Math::PI * unif_rng.sample }
  x_in = theta_in.map do |el|
    [ 1 - Math::cos(el), 1 - Math::sin(el) - 0.5 ]
  end
  # theta_in = Numo::DFloat.linspace(0, Math::PI, n_samples_in)
  # x_in = Numo::DFloat[1 - theta_in.cos, 1 - theta_in.sin - 0.5].transpose

  # Add noise
  if noise && noise > 0.0
    x_in.each do |point|
      point[0] += gaussian_rng.sample; point[1] += gaussian_rng.sample
    end
    x_out.each do |point|
      point[0] += gaussian_rng.sample; point[1] += gaussian_rng.sample
    end
  end

  # Create labels
  y_in = Array.new(n_samples_in) { 1 }
  y_out = Array.new(n_samples_out) { 0 }

  # Combine the two circles
  return x_in + x_out, y_in + y_out
end

# Function to save the generated moons as a PNG image
# Parameters
# - X: Numo::DFloat array of shape (n_samples, 2) containing the coordinates
# - y: Numo::Int32 array of shape (n_samples,) containing the labels
# - filename: Name of the output PNG file (default: 'moons.png')
# - width: Width of the output image (default: 400)
# - height: Height of the output image (default: 400)
# - margin: Margin around the points in the image (default: 20)
# - point_radius: Radius of the points in the image (default: 3)
# - colors: Array of colors for the two classes (default: ['red', 'blue'])
def save_moons_as_png(x, y, filename: 'moons.png', width: 400, height: 400, margin: 20, point_radius: 3, colors: ['red', 'blue'])
  # Normalize coordinates to fit within the image dimensions
  x_min = 0
  x_max = 0
  y_min = 0
  y_max = 0
  x.each do |point|
    x_min = point[0] if point[0] < x_min
    x_max = point[0] if point[0] > x_max
    y_min = point[1] if point[1] < y_min
    y_max = point[1] if point[1] > y_max
  end

  scale_x = (width - 2 * margin) / (x_max - x_min)
  scale_y = (height - 2 * margin) / (y_max - y_min)

  png = ChunkyPNG::Image.new(width, height, ChunkyPNG::Color::WHITE)
  red  = ChunkyPNG::Color.rgba(255, 0,   0,   255)
  blue = ChunkyPNG::Color.rgba(0,   0, 255,   255)

  x.each_with_index do |point,i|
    x_img = ((point[0] - x_min) * scale_x + margin).to_i
    y_img = (height - ((point[1] - y_min) * scale_y + margin)).to_i # Invert y-axis for image coordinates

    # puts "Point #{i}: (#{point[0]}, #{point[1]}) -> (#{x_img}, #{y_img})"
    # puts "Color: #{y[i] == 1 ? 'red' : 'blue'}"
    color = (y[i] == 1) ? red : blue

    # Draw the point as a filled circle
    (-point_radius..point_radius).each do |dx|
      (-point_radius..point_radius).each do |dy|
        if dx**2 + dy**2 <= point_radius**2
          px = x_img + dx
          py = y_img + dy
          if px.between?(0, width - 1) && py.between?(0, height - 1)
            png[px, py] = color
          end
        end
      end
    end
  end

  png.save(filename)
end

# Function to save the generated moons as a CSV file
# Parameters
# - X: Numo::DFloat array of shape (n_samples, 2) containing the coordinates
# - y: Numo::Int32 array of shape (n_samples,) containing the labels
# - filename: Name of the output CSV file (default: 'moons.csv')
def save_moons_as_csv(x, y, filename: 'moons.csv')
  File.open(filename, 'w') do |file|
    file.puts('x1,x2,label')
    x.each_with_index do |p,i|
      file.puts("#{p[0]},#{p[1]},#{y[i]}")
    end
  end
end

# Example usage
if __FILE__ == $0
  n_samples = 1000
  noise = 0.1
  seed = SecureRandom.random_number(10000)

  x, y = generate_moons(n_samples: n_samples, noise: noise, seed: seed)
  save_moons_as_png(x, y, filename: 'moons.png')
  save_moons_as_csv(x, y, filename: 'moons.csv')

  puts "Generated #{n_samples} samples with noise=#{noise} and seed=#{seed}"
  puts "Saved moons.png and moons.csv"
end
